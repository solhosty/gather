# Roundup environment template
#
# Copy to `.env.local` for local server work. Never commit `.env.local`.
# Each configuration value appears once. The API may read EXPO_PUBLIC_* values
# too; the prefix only means Expo is allowed to inline that value in a client
# build. Never put a secret behind that prefix.

###############################################################################
# Client-safe Expo configuration
###############################################################################

# `development` | `preview` | `production`. The current app can run locally
# without any provider credentials when EXPO_PUBLIC_DEMO_MODE=true.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:8081
EXPO_PUBLIC_APP_SCHEME=roundup

# Privy application identifier. This is shared by client and server because it
# is an identifier, not a secret. Create it in the Privy dashboard.
EXPO_PUBLIC_PRIVY_APP_ID=
# Public identifiers for the separate Roundup web and iOS clients in Privy.
# They are distinct from the app ID and must match the current platform.
EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=
EXPO_PUBLIC_PRIVY_IOS_CLIENT_ID=

# Stripe publishable key for test mode only (begins with pk_test_). This may be
# exposed to the client; it cannot create charges or retrieve private data alone.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public Solana devnet settings. The API reuses these exact values too.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

###############################################################################
# Server-only configuration (for the future API/worker; never import in Expo)
###############################################################################

# PostgreSQL. Use a local non-production database for development.
DATABASE_URL=postgresql://roundup:roundup@127.0.0.1:5432/roundup_dev

# Privy server-only credentials. Store these in a secret manager outside local
# development. The app ID above is intentionally not repeated here. The signing
# key is created in Privy's dashboard when server-side delegated actions are
# enabled; Privy does not require a separate authorization-key ID for this flow.
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
EXPO_PUBLIC_PRIVY_AUTHORIZATION_KEY_ID=
EXPO_PUBLIC_PRIVY_AUTOMATION_POLICY_ID=

# Stripe test-mode server credentials. Financial Connections is read-only for
# Roundup. The webhook secret verifies Stripe's signed webhook requests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Derive Stripe Financial Connections return URLs from EXPO_PUBLIC_WEB_URL and
# EXPO_PUBLIC_APP_SCHEME rather than storing duplicate values.

# Server runtime configuration.
API_PORT=3000

# Server-side Solana configuration. The key below is only for the no-value
# devnet stock-mirror mint authority; it must never be an end-user wallet key.
# One devnet-only authority for minting and fee payment during the demonstration.
# Never use an end-user wallet key here.
SOLANA_DEMO_AUTHORITY_SECRET_KEY=
# Store the matching local keypair file in the ignored `.keys/` directory.

# Server-side reference market data for M7.5. This key must never be exposed
# to Expo clients; quotes describe the underlying equity, never the no-value
# devnet mirror token.
TWELVE_DATA_API_KEY=

# Provider-created identifiers (policy IDs, mint addresses, wallet IDs) belong
# in PostgreSQL as versioned configuration, not in environment variables.

###############################################################################
# Dashboard-only setup (not environment variables)
###############################################################################

# Privy: enable Google, Apple, and GitHub/OAuth login; configure web and iOS
# redirect URLs; enable embedded Solana wallets; create a consented delegated
# signer/policy only after the policy engine is implemented.
#
# Stripe: remain in test mode; enable Financial Connections transaction access;
# configure the endpoint that receives and verifies webhooks. Do not use a live
# Stripe key for this devnet demo.
